{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ml_insights.json schema v3 (bộ số mẫu chỉ minh họa, backtest so với 1.000 lần chọn ngẫu nhiên)",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 3
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "latest_id": {
      "type": "string",
      "pattern": "^\\d{4,8}$"
    },
    "latest_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "disclaimer": {
      "type": "string",
      "pattern": "không làm tăng xác suất trúng"
    },
    "jackpot_odds": {
      "const": "1/28.989.675"
    },
    "sample_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sample_picks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(0[1-9]|[1-4]\\d|5[0-5])$"
            },
            "minItems": 6,
            "maxItems": 6,
            "uniqueItems": true
          },
          "description": {
            "type": "string",
            "pattern": "\\(chỉ minh họa\\)"
          }
        },
        "required": [
          "name",
          "sample_picks",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "backtests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_draws",
          "simulations",
          "expected_average",
          "random",
          "strategies"
        ],
        "properties": {
          "test_draws": {
            "type": "integer",
            "minimum": 1
          },
          "simulations": {
            "type": "integer",
            "minimum": 100
          },
          "expected_average": {
            "type": "number",
            "minimum": 0
          },
          "random": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mean_average",
              "low_95",
              "high_95",
              "histogram"
            ],
            "properties": {
              "mean_average": {
                "type": "number",
                "minimum": 0
              },
              "low_95": {
                "type": "number",
                "minimum": 0
              },
              "high_95": {
                "type": "number",
                "minimum": 0
              },
              "histogram": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "average_matches",
                  "counts"
                ],
                "properties": {
                  "average_matches": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0
                    },
                    "minItems": 1
                  },
                  "counts": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 1
                  }
                }
              }
            }
          },
          "strategies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "strategy_name",
                "average_matches",
                "total_matches",
                "max_match_in_one_draw",
                "hit_rate_at_least_3",
                "hit_rate_at_least_4",
                "p_value"
              ],
              "properties": {
                "strategy_name": {
                  "type": "string",
                  "minLength": 1
                },
                "average_matches": {
                  "type": "number",
                  "minimum": 0
                },
                "total_matches": {
                  "type": "integer",
                  "minimum": 0
                },
                "max_match_in_one_draw": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "hit_rate_at_least_3": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "hit_rate_at_least_4": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "p_value": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "product",
    "latest_id",
    "latest_date",
    "disclaimer",
    "jackpot_odds",
    "sample_sets",
    "backtests"
  ],
  "additionalProperties": false
}
