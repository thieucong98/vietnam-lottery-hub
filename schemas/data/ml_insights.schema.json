{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ml_insights.json schema v2 (bộ số mẫu chỉ minh họa, sau Phase 0)",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "latest_id": {
      "type": "string",
      "pattern": "^\\d{4,8}$"
    },
    "latest_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "disclaimer": {
      "type": "string",
      "pattern": "không làm tăng xác suất trúng"
    },
    "jackpot_odds": {
      "const": "1/28.989.675"
    },
    "sample_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sample_picks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(0[1-9]|[1-4]\\d|5[0-5])$"
            },
            "minItems": 6,
            "maxItems": 6,
            "uniqueItems": true
          },
          "description": {
            "type": "string",
            "pattern": "\\(chỉ minh họa\\)"
          }
        },
        "required": [
          "name",
          "sample_picks",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "backtest_report": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "strategy_name": {
            "type": "string"
          },
          "test_draws": {
            "type": "integer",
            "minimum": 0
          },
          "average_matches": {
            "type": "number",
            "minimum": 0
          },
          "max_match_in_one_draw": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "hit_rate_at_least_3": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?%$"
          },
          "hit_rate_at_least_4": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?%$"
          }
        },
        "required": [
          "strategy_name",
          "test_draws",
          "average_matches",
          "max_match_in_one_draw",
          "hit_rate_at_least_3",
          "hit_rate_at_least_4"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "product",
    "latest_id",
    "latest_date",
    "disclaimer",
    "jackpot_odds",
    "sample_sets",
    "backtest_report"
  ],
  "additionalProperties": false
}
