{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vietlott_655_index.json",
  "type": "object",
  "properties": {
    "product": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "latest_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "latest_id": {
          "type": "string",
          "pattern": "^\\d{4,8}$"
        },
        "total_draws": {
          "type": "integer",
          "minimum": 1
        },
        "max_number": {
          "const": 55
        }
      },
      "required": [
        "latest_date",
        "latest_id",
        "total_draws",
        "max_number"
      ]
    },
    "latest_draw": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "id": {
          "type": "string",
          "pattern": "^\\d{4,8}$"
        },
        "result": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 55
          },
          "minItems": 7,
          "maxItems": 7
        }
      },
      "required": [
        "date",
        "id",
        "result"
      ]
    },
    "top_gan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^\\d{2}$"
          },
          "days_since": {
            "type": "integer",
            "minimum": 0
          },
          "last_date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_gap": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "number",
          "days_since",
          "last_date",
          "max_gap"
        ]
      },
      "minItems": 1
    },
    "top_frequent": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^\\d{2}$"
          },
          "freq_100d": {
            "type": "integer",
            "minimum": 0
          },
          "total_hits": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "number",
          "total_hits"
        ]
      },
      "minItems": 1
    },
    "numbers": {
      "type": "object",
      "patternProperties": {
        "^\\d{2}$": {
          "type": "object",
          "properties": {
            "number": {
              "type": "string",
              "pattern": "^\\d{2}$"
            },
            "total_hits": {
              "type": "integer",
              "minimum": 0
            },
            "days_since_last": {
              "type": "integer",
              "minimum": 0
            },
            "first_seen_date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "last_seen_date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_gap_historical": {
              "type": "integer",
              "minimum": 0
            },
            "average_gap": {
              "type": "number",
              "minimum": 0
            },
            "freq_30d": {
              "type": "integer",
              "minimum": 0
            },
            "freq_100d": {
              "type": "integer",
              "minimum": 0
            },
            "gan_risk_gauge": {
              "type": "number",
              "minimum": 0
            },
            "yearly_distribution": {
              "type": "object",
              "patternProperties": {
                "^\\d{4}$": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "recent_history": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^\\d{4,8}$"
                  },
                  "result": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 55
                    },
                    "minItems": 7,
                    "maxItems": 7
                  }
                },
                "required": [
                  "date",
                  "id",
                  "result"
                ]
              }
            }
          },
          "required": [
            "number",
            "total_hits",
            "days_since_last",
            "last_seen_date",
            "max_gap_historical",
            "average_gap",
            "freq_30d",
            "freq_100d",
            "gan_risk_gauge",
            "recent_history"
          ]
        }
      },
      "additionalProperties": false,
      "minProperties": 55,
      "maxProperties": 55
    }
  },
  "required": [
    "product",
    "metadata",
    "latest_draw",
    "top_gan",
    "top_frequent",
    "numbers"
  ]
}
