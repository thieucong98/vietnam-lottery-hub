            "freq_30d": {
              "type": "integer",
              "minimum": 0
            },
            "freq_60d": {
              "type": "integer",
              "minimum": 0
            },
            "freq_100d": {
              "type": "integer",
              "minimum": 0
            },
            "freq_365d": {
              "type": "integer",
              "minimum": 0
            },
            "is_gan": {
              "type": "boolean"
            },
            "gan_risk_gauge": {
              "type": "number",
              "minimum": 0
            },
            "top_pairs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "number": {
                    "type": "string",
                    "pattern": "^\\d{2}$"
                  },
                  "co_count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "number",
                  "co_count"
                ]
              }
            },
            "yearly_distribution": {
              "type": "object",
              "patternProperties": {
                "^\\d{4}$": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "recent_history": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "prizes": {
                    "type": "array",
