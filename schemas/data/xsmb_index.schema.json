            "type": "string",
            "pattern": "^\\d{2}$"
          },
          "days_since": {
            "type": "integer",
            "minimum": 0
          },
          "last_date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_gap": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "number",
          "days_since",
          "last_date",
          "max_gap"
        ]
      },
